{
  "expo": {
    "name": "Nianza",
    "slug": "nianza",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "nianza",
    "icon": "./assets/brand/app-icon-1024.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/splash-tagline.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FA"
    },
    "ios": {
      "bundleIdentifier": "com.nianza.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Nianza uses the microphone so you can speak to Patricia hands-free.",
        "NSPhotoLibraryUsageDescription": "Nianza uses your photo library when you choose to add a child photo or share a photo with Patricia.",
        "NSCameraUsageDescription": "Nianza uses your camera when you choose to take a photo to add or share.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nianza.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-tagline.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F9FA"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nianza uses your photo library when you choose to add a child photo or share a photo with Patricia.",
          "cameraPermission": "Nianza uses your camera when you choose to take a photo to add or share."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "apiUrl": "https://gr8d5s0yl9.execute-api.us-east-2.amazonaws.com/prod/mobile/v1",
      "router": {},
      "eas": {
        "projectId": "10dafae0-d29b-4af0-a469-ce54a0eceb81"
      }
    },
    "owner": "ejaugust2"
  }
}
